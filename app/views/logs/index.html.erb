<% content_for :title, "Dashboard" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0 fw-bold">Dashboard</h1>
  <div class="d-flex gap-2">
    <% Log.levels.each do |level| %>
      <%= link_to level.capitalize,
            logs_path(levels: [level]),
            class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <%= link_to "All", logs_path, class: "btn btn-sm btn-primary" %>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Time</th>
          <th>Level</th>
          <th>Project</th>
          <th>User (UUID)</th>
          <th>Message</th>
        </tr>
      </thead>
      <tbody>
        <% if @logs.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-5">No log entries yet.</td></tr>
        <% else %>
          <% @logs.each do |log| %>
            <tr>
              <td class="text-muted small"><%= friendly_time(log.created_at) %></td>
              <td><span class="<%= log_level_badge(log.level) %>"><%= log.level %></span></td>
              <td><%= log.project&.title || "—" %></td>
              <td class="font-monospace small"><%= truncate_key(log.user&.uuid, length: 16) %></td>
              <td><%= log.message %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer">
    <%= paginate @logs %>
  </div>
</div>
