<h2>Set Your Password</h2>
<%= form_for current_client, url: clients_password_setup_path, method: :patch do |f| %>
  <div class="mb-3"><%= f.label :password %><%= f.password_field :password, class: "form-control", minlength: 8 %></div>
  <div class="mb-3"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation, class: "form-control" %></div>
  <%= f.submit "Set Password", class: "btn btn-primary" %>
<% end %>
