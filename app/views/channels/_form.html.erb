<%= form_with model: channel do |f| %>
  <% if channel.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% channel.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label fw-semibold" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Postmark Production" %>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :method, "Delivery Method", class: "form-label fw-semibold" %>
      <%= f.select :method, Channel.delivery_methods.map { |m| [m.capitalize, m] },
            { prompt: "Select method…" }, { class: "form-select" } %>
    </div>
    <div class="col-md-6">
      <%= f.label :provider, class: "form-label fw-semibold" %>
      <%= f.select :provider, Channel.providers.map { |p| [p[:name], p[:handle]] },
            { prompt: "Select provider…" }, { class: "form-select" } %>
    </div>
  </div>
  <div class="mb-4">
    <%= f.label :credentials, "Credentials (JSON)", class: "form-label fw-semibold" %>
    <%= f.text_area :credentials, class: "form-control font-monospace", rows: 5,
          placeholder: '{"api_key": "...", "from_email": "noreply@yoursite.com"}' %>
    <div class="form-text">Enter your provider credentials as a JSON object. This value is encrypted at rest.</div>
  </div>
  <%= f.submit channel.new_record? ? "Create Channel" : "Update Channel", class: "btn btn-primary px-4" %>
  <%= link_to "Cancel", channels_path, class: "btn btn-light ms-2" %>
<% end %>
