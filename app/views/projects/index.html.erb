<% content_for :title, "Projects" %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0 fw-bold">Projects</h1>
  <%= link_to "New Project", new_project_path, class: "btn btn-primary" %>
</div>
<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>Title</th><th>Public Key</th><th>Channel</th><th>Template</th><th>Expiry</th><th></th></tr>
      </thead>
      <tbody>
        <% if @projects.empty? %>
          <tr><td colspan="6" class="text-center text-muted py-5">No projects yet. <%= link_to "Create one", new_project_path %>.</td></tr>
        <% else %>
          <% @projects.each do |p| %>
            <tr>
              <td class="fw-semibold"><%= link_to p.title, p %></td>
              <td class="font-monospace small text-muted"><%= truncate_key(p.public_key) %></td>
              <td><%= p.channel&.title || "—" %></td>
              <td><%= p.template&.title || "—" %></td>
              <td><%= p.expiration_seconds %>s</td>
              <td class="text-end">
                <%= link_to "Edit", edit_project_path(p), class: "btn btn-sm btn-outline-secondary me-1" %>
                <%= link_to "Delete", p, data: { turbo_method: :delete, turbo_confirm: "Delete #{p.title}?" }, class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer"><%= paginate @projects %></div>
</div>
